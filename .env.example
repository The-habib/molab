# Cloud PC Control Plane Environment Configuration
# Copy this file to .env or let the tool auto-generate it on first launch

HOST=127.0.0.1
PORT=8800

# Web Dashboard Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Cryptographic Secrets (auto-generated on first run if blank)
ADMIN_SESSION_SECRET=your_32_byte_hex_session_secret
AGENT_AUTH_TOKEN=your_32_byte_hex_agent_auth_token

LOG_LEVEL=INFO
